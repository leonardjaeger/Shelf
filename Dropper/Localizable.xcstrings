          }
        }
      }
    },
    "Der Kurzbefehl aus der App „Kurzbefehle“ bekommt die Einträge als Eingabe (wie „shortcuts run Name -i Datei …“)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The shortcut from the Shortcuts app receives the items as input (like “shortcuts run Name -i File …”)."
          }
        }
      }
    },
