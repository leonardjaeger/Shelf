      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file is also renamed in the Finder."
          }
        }
      }
    },
    "Die Originale bleiben, wo sie sind – auch im Finder auf demselben Laufwerk." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The originals stay where they are – even in the Finder on the same drive."
