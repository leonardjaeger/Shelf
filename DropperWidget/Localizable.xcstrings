      }
    },
    "Dropper einmal starten, damit hier die Shelves erscheinen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch Dropper once so your shelves show up here."
          }
        }
      }
    },
    "Geschlossen %@ · %@": {
