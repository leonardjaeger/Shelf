    "Neues Shelf": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New Shelf"
          }
        }
      }
    },
    "Noch keine Shelves – Dateien beim Ziehen schütteln öffnet eins.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No shelves yet – shake files while dragging to open one."
          }
        }
      }
    },
    "Offene und zuletzt geschlossene Shelves – ein Klick holt sie nach vorn oder öffnet sie wieder.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open and recently closed shelves – one click brings them to the front or reopens them."
          }
        }
      }
    },
